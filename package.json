{
  "name": "discerns",
  "version": "0.3.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test --pass-with-no-tests",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepare": "vp config",
    "db": "drizzle-kit",
    "deps": "pnpm dlx taze@latest -Ilw --maturity-period 3",
    "tanstack": "pnpm dlx @tanstack/cli@latest",
    "ui": "pnpm dlx shadcn@latest",
    "auth": "pnpm dlx auth@latest",
    "auth:secret": "pnpm dlx auth@latest secret",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth/auth.cli.ts --y --output ./src/lib/db/schema/auth.schema.ts",
    "auth:migrate": "vp run auth:generate && vp run db:generate && vp run db:migrate:local",
    "skills": "pnpm dlx skills@latest",
    "intent": "pnpm dlx @tanstack/intent@latest",
    "skill:pack": "cd plugins/discerns/skills && rm -f ../../../public/downloads/discerns-skill.zip && zip -qr ../../../public/downloads/discerns-skill.zip discerns && awk 'n>=2{print} /^---$/{n++}' discerns/SKILL.md | sed '/./,$!d' > ../../../public/downloads/discerns-agent.md",
    "deploy": "vp run skill:pack && vp build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "postinstall": "WRANGLER_LOG=warn wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "@dodopayments/better-auth": "1.6.6",
    "@dodopayments/core": "0.3.15",
    "@fontsource-variable/inter": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@uiw/react-codemirror": "4.25.12",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dodopayments": "2.54.0",
    "drizzle-orm": "1.0.0-rc.4",
    "evlog": "2.30.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxc-transform-react": "0.153.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "generator": "create-cove",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
